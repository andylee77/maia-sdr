*~
\#*\#
\.\#*

# Fork-specific local files
.clinerules
.claude/

# ── Build artifacts ──────────────────────────────────────────────────────────

# Generated Verilog and SVD (produced by build_hdl.bat / build_fpga.bat)
maia-hdl/ip/maia-sdr/default/
maia-hdl/ip/maia-sdr/maia_iio/
maia-hdl/ip/maia-sdr/maia_iio_lite/
maia-hdl/ip/p25-core/default/
maia-hdl/maia-sdr.svd

# Rust build artifacts -- workspace-root target/ AND any per-subcrate
# target/ that gets created if cargo runs from inside a subcrate
# (e.g. cd p25-httpd/p25-pac && cargo check creates p25-pac/target/).
p25-httpd/target/
p25-httpd/**/target/
maia-httpd/target/
maia-httpd/**/target/

# Vivado project artifacts (produced by build_fpga.bat)
*.xpr
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sdk/
*.srcs/
.Xil/

# Simulation output (produced by sim_hdl.bat)
sim_output/

# Vivado logs
vivado*.log
vivado*.jou
vivado*.str

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
dist/
build/
runs/

# P25 LSM aligned-capture diagnostic snapshots (one-shot dumps from
# /api/lsm_capture_aligned, used as input to tools/p25_decode_capture.py).
# These are throwaway debug artifacts -- don't commit them.
/capture*.json

*~
\#*\#
\.\#*

# Fork-specific local files
.clinerules
.claude/

# ── Build artifacts ──────────────────────────────────────────────────────────

# Generated Verilog and SVD (produced by build_hdl.bat / build_fpga.bat)
maia-hdl/ip/maia-sdr/default/
maia-hdl/ip/maia-sdr/maia_iio/
maia-hdl/ip/maia-sdr/maia_iio_lite/
maia-hdl/ip/p25-core/default/
maia-hdl/maia-sdr.svd

# Rust build artifacts -- workspace-root target/ AND any per-subcrate
# target/ that gets created if cargo runs from inside a subcrate
# (e.g. cd p25-httpd/p25-pac && cargo check creates p25-pac/target/).
p25-httpd/target/
p25-httpd/**/target/
maia-httpd/target/
maia-httpd/**/target/

# Vivado project artifacts (produced by build_fpga.bat)
*.xpr
*.cache/
*.gen/
*.hw/
*.ip_user_files/
*.runs/
*.sdk/
*.srcs/
.Xil/

# Simulation output (produced by sim_hdl.bat)
sim_output/

# Vivado logs
vivado*.log
vivado*.jou
vivado*.str

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
dist/
build/
runs/

# P25 LSM aligned-capture diagnostic snapshots (one-shot dumps from
# /api/lsm_capture_aligned, used as input to tools/p25_decode_capture.py).
# These are throwaway debug artifacts -- don't commit them.
/capture*.json

# HDL register-bank snapshot JSONs dumped by /api/hdl_dump or
# similar diagnostic endpoints during live on-target debugging.
# Same throwaway category as capture*.json above.
/hdl_cap*.json

# One-shot vocoder and IMBE test artefacts (raw PCM / wav files
# written by test scripts during interactive mbelib validation).
# Not inputs to any committed test; keep them out of history.
/jmbe_audio_test.wav
/maia-hdl/decimator_out.cs16
/maia-hdl/*.cs16

# Voice-capture tool output directories. tools/voice_capture.py
# writes a new timestamped directory per run (voice_capture_YYYYMMDD_HHMMSS/).
# These accumulate quickly during live testing -- ignore the pattern.
/tools/voice_capture_*/

# Bake output logs
build_fpga*.log
build_hdl*.log

# ── Field-diagnostic dumps (not curated repo content) ─────────────

# On-target diagnostic captures written by tools/p25_* scripts or
# by /api/*_capture endpoints. Eye diagrams, constellation plots,
# debug log rings, retune probes, audio analyses — one-shot
# artefacts from field testing, sometimes GB-scale, never source
# of truth. Keep them out of git history.
doc/diagnostics/

# EPS / health-probe outputs written by tools/*.py
/eps.json
/eps_*.json

# Timeseries JSONL / CSV dumps
*.jsonl

# Per-recording WAV fragments (real storage is /tmp/p25_recordings
# on target; root-level .wav is always a stray test artefact).
/p25_recordings/
/*.wav

# On-host Rust build droppings that occasionally escape target/
Cargo.lock.bak
*.rlib.bak

# 2026-04-25: additional on-host probe + dump artefacts produced
# during the unified-call-lifecycle / AGC / auto-PPM debug work.
# Same throwaway category as capture*.json above — not source.

# AGC, PPM, signal-quality, log/stats/system probes from
# tools/*.py + /api/* one-shot dumps.
/agc_*.json
/ppm_*.json
/dev.json
/dev_*.json
/dist_*.json
/health_*.json
/stats.json
/stats_*.json
/sys_*.json
/log_*.json
/wb.json
/wb_*.json
/narrow.json
/const.json
/traffic_*.json

# Tezuka build logs scraped to host for analysis
/tezuka_*.log
/tezuka_*.out
/bake*.log

# On-host validation + sweep output directories
/_validation/
/gain_sweep/
/wb_frames_check/

# p25-httpd full-API JSON dumps
/p25-httpd/log_full.json
